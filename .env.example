# ============================================================
# auth_proxy environment configuration
# ============================================================
# Copy this file to .env and fill in the values for your IdP.
# .env is gitignored and never checked in.
# ============================================================

# Base URL of your upstream OAuth2 / OpenID Connect Identity Provider.
# Example: https://auth.example.local
IDP_BASE_URL=https://auth.example.local

# Full URL to the IdP's JWKS endpoint.
# Used to fetch public keys for JWT signature verification.
# Example: https://auth.example.local/.well-known/jwks.json
IDP_JWKS_URI=https://auth.example.local/.well-known/jwks.json

# Device Authorization Endpoint (RFC 8628).
# The auth proxy relays POST /oauth/device requests here.
# Example: https://auth.example.local/oauth/device_authorization
IDP_DEVICE_AUTH_ENDPOINT=https://auth.example.local/oauth/device_authorization

# Token Endpoint (RFC 6749).
# The auth proxy relays POST /oauth/token requests here.
# Example: https://auth.example.local/oauth/token
IDP_TOKEN_ENDPOINT=https://auth.example.local/oauth/token

# Expected value of the `aud` (audience) claim in JWTs issued by the IdP.
# Must match what your IdP sets when issuing tokens for this channel.
# Example: conda-channel
IDP_AUDIENCE=conda-channel

# Expected value of the `iss` (issuer) claim in JWTs.
# Must exactly match the `iss` your IdP embeds in tokens.
# Example: https://auth.example.local
IDP_ISSUER=https://auth.example.local

# OAuth2 client_id to embed in WWW-Authenticate challenge responses.
# conda-auth uses this to initiate the correct Device Flow request.
# Example: conda-client
IDP_CLIENT_ID=conda-client
